# ═════════════════════════════════════════════════════════════════════════════
#  服务器 B — sandbox-executor 环境变量样例
#
#  部署位置：/etc/sandbox-executor/executor.env
#  由 sandbox-executor.service 的 EnvironmentFile= 读取。
#
#      install -d -m 750 /etc/sandbox-executor
#      install -m 640 /etc/sandbox-executor/executor.env   # 见下面的权限说明
#      chown root:sandboxexec /etc/sandbox-executor/executor.env
#
#  **权限**：这个文件里有 SANDBOX_TOKEN，拿到它就能让 B 起容器（并且能读写 A 导出的
#  整个工作区）。640 + root:sandboxexec 让服务读得到、其他用户读不到。别用 644。
#
#  规则：**没写的键就用默认值**。所以下面标了「默认」的都可以整行删掉，只有
#  SANDBOX_TOKEN 和 SANDBOX_IMAGE 是必填（缺了 load_config 直接抛，服务起不来）。
# ═════════════════════════════════════════════════════════════════════════════

# ── 必填 ──────────────────────────────────────────────────────────────────────

# A 与 B 之间的共享令牌。生成：openssl rand -hex 32
# A 侧写在 /opt/blog/后端/.env 的 SANDBOX_EXECUTOR_TOKEN，两边必须逐字相同。
# 用 hmac.compare_digest 常量时间比较（两个 token 都比完再下结论，不短路）。
#
# ── 轮换（无 401 中断的三步走，依赖下面的 SANDBOX_TOKEN_PREVIOUS）────────────
#
#   1. B：SANDBOX_TOKEN=<新>、SANDBOX_TOKEN_PREVIOUS=<旧>，重启 sandbox-executor
#      （此刻新旧两个 token 都被接受；启动日志会打"轮换窗口开启"）
#   2. A：/opt/blog/后端/.env 里 SANDBOX_EXECUTOR_TOKEN=<新>，重启 blog
#   3. B：删掉 SANDBOX_TOKEN_PREVIOUS 整行，重启 sandbox-executor
#      （旧 token 从此 401）
#
# 顺序不能反：先在 B 开窗口再切 A，A 的请求在任何时刻都拿着一个被接受的 token。
# 窗口拖太久 = 旧 token（可能已泄露的那个）一直有效，切完 A 尽快收尾。
# 验证收尾：journalctl -u sandbox-executor | grep 轮换 → 应无输出；
# exec.jsonl 里 event=refused reason=auth 的记录在窗口期应为零。
SANDBOX_TOKEN=

# 轮换重叠窗口里的旧 token（可选）。不设或留空 = 单 token 模式。
# 除轮换期外保持注释掉 —— 多一个被接受的 token 就是多一份被泄露的攻击面。
#SANDBOX_TOKEN_PREVIOUS=

# 沙箱镜像。**镜像版本由 B 单一持有，A 不传 tag** —— 换镜像不用动 A。
# A 只通过 GET /healthz 读到 image 字段记日志、与自己期望不一致时告警。
# 值来自构建时的 TAG（与手册 §1.4、Dockerfile 顶部注释同一公式）：
#   TAG=$(cat Dockerfile requirements-sandbox.txt | sha256sum | cut -c1-12)
# 当前内容对应 ee3c501f3b33。改了那两个文件里任何一个 tag 就变，这里要跟着填；
# 也可以用 `python 后端/tests/verify_stage2c.py --print-tag` 直接问出来。
SANDBOX_IMAGE=blog-sandbox:000000000000

# ── NFS 挂载点 ────────────────────────────────────────────────────────────────

# A 导出的工作区根（rw）。默认 /mnt/blog-ws
# 容器里固定映射成 /workspace，用户代码看到的路径与 A 侧 redact 后的 <工作区> 一致。
#SANDBOX_NFS_WS_ROOT=/mnt/blog-ws

# A 导出的技能库根（ro）。默认 /mnt/blog-skills
# 容器里固定映射成 /skills:ro。
#SANDBOX_NFS_SKILLS_ROOT=/mnt/blog-skills

# ── 挂载新鲜度校验（整个方案里最重要的一道防线）───────────────────────────────
#
# NFS 挂载失效时 bind mount 会挂到**空目录**上，沙箱在空目录里跑 → 用户看到
# "文件全没了"。这一层把它从静默数据丢失变成响亮拒绝服务：不新鲜就 503，绝不放行。
# 三层校验：mountpoint -q / stat -f -c %T 必须是 nfs / 哨兵文件时间戳新鲜度。

# 关闭校验。**只有开发机全链路验证时才设 0**（本机没有 NFS）。生产设 0 等于把
# 上面那道防线拆掉 —— executor 启动时会往 stderr 打一条大字警告。默认 1。
#SANDBOX_REQUIRE_NFS=1

# 哨兵文件名，位于 SANDBOX_NFS_WS_ROOT 下。默认 .sandbox_nfs_ok
# A 侧 cron 每分钟改写它：* * * * * date +\%s > /opt/blog/workspaces/.sandbox_nfs_ok
#SANDBOX_SENTINEL_NAME=.sandbox_nfs_ok

# 哨兵最大年龄（秒）。默认 180 = A 的 cron 连续 3 个周期没动就算挂载死了。
# 调小会更早拒绝服务（A 的 cron 偶尔被负载拖延就会误伤），调大则真的挂载失效时
# 放行窗口更长。注意 A 的时钟**快**于 B 会得到负年龄 → 通过（无害）；A 的时钟
# **慢**于 B 超过这个值 → 永久 503，从日志里的 age 数值一眼能看出来。最小 10。
#SANDBOX_SENTINEL_MAX_AGE=180

# 探测结果缓存秒数。默认 5.0 —— healthz 和每个 /execute 都会探测，不缓存会让
# 每次请求多打 4 个 mountpoint/stat 子进程。调大会让"刚挂上"到"开始放行"之间有延迟。
#SANDBOX_PROBE_TTL=5

# 单次探测总超时（秒）。默认 8.0，最小 1.0。
# NFS 挂成 hard 时 read()/stat() 是**不可中断的无限阻塞**，asyncio.wait_for 只能
# 放弃等待、杀不掉那个线程；超时后返回 not ready 并且**不写进缓存**（缓存只应该
# 反映真实探测到了什么）。防止线程叠加靠的是探测里的单飞锁，不是这个超时。
#SANDBOX_PROBE_TIMEOUT=8

# ── 资源上限 ──────────────────────────────────────────────────────────────────

# 并发执行数。默认 2 —— B 是 2 核 2GB，真正该限的是 B，不是 A。
# 满了立刻返回 429（在**读 body 之前**，不给要拒绝的请求缓冲 2MB），A 侧文案沿用
# 现有的"系统繁忙"。调大前先算内存：每容器 SANDBOX_MEMORY_MB，2GB 机器上
# 3 个 384m 容器 + dockerd 就已经贴着上限了。
#SANDBOX_MAX_CONCURRENT=2

# 每容器内存上限（MB），对应 docker run --memory。默认 384。
# 为什么不是今天 local 后端的 256：RLIMIT_AS 限**地址空间**，--memory 限**真实
# RSS + page cache**，语义不同，numpy/OpenBLAS 预留大量 VA 会被 256 误杀。
# 起步 384，看 exec.jsonl 里的实际峰值观察一两周再收紧。
# **注意 tmpfs 计入这个 cgroup**（/tmp 写满就吃掉对应预算，/dev/shm 默认另给 64MB
# 同样计费）—— 所以 SANDBOX_TMPFS_MB 保持小。
# --memory-swap 自动取 memory + 128，允许溢出到 swapfile 而不是直接 OOM kill。
#SANDBOX_MEMORY_MB=384

# /tmp 的 tmpfs 大小（MB）。默认 32，最小 8。
# **这一项是功能必需，不是优化**：镜像里 MPLCONFIGDIR=/tmp/mplcache、
# XDG_CACHE_HOME=/tmp/.cache，--read-only 的根文件系统上没有 tmpfs 的话
# matplotlib 会退回 mkdtemp 并往 stderr 打两条 WARNING，而 A 侧在用户代码没有
# stdout 时会把 stderr 当作工具结果返回 —— 用户看到的就是一堆无关警告。
#SANDBOX_TMPFS_MB=32

# 单文件写入上限（字节），对应 --ulimit fsize。默认 52428800 = 50MB。
# **必须与 A 侧 workspace_service.MAX_FILE_SIZE 一致**（有单元测试交叉钉住），
# 否则容器里写得出来、A 侧同步不进去，表现为"文件生成成功但工作区里没有"。
#SANDBOX_FSIZE_BYTES=52428800

# 请求体里 script 的字节上限。默认 2097152 = 2MB。超了返回 413。
# 沙箱脚本模板本身约 40KB，2MB 已经是 50 倍余量。
#SANDBOX_MAX_SCRIPT_BYTES=2097152

# ── 超时 ──────────────────────────────────────────────────────────────────────

# 请求未指定 timeout 时用的默认值（秒）。默认 120.0。
# **与 A 侧 tool_registry.PYTHON_TIMEOUT 一致**（有单元测试交叉钉住）。
#SANDBOX_DEFAULT_TIMEOUT=120

# 允许的 timeout 上限（秒），超过就夹到这个值。默认 120.0。
# 夹取在 B 侧做，不能只信 A：A 被攻破时这是防止一次执行长期占住并发槽的最后一道。
#SANDBOX_MAX_TIMEOUT=120

# 容器创建 + python import 的墙钟余量（秒）。默认 10.0。
# 实际等待上限 = timeout + startup_grace。镜像烤了 pyc 与 matplotlib 字体缓存，
# 冷启动大头是 Python + 科学计算库 import，10s 在 2vCPU 上足够。
#SANDBOX_STARTUP_GRACE=10

# ── 容器运行环境 ──────────────────────────────────────────────────────────────

# 传给容器的 TZ。默认 Asia/Shanghai。
# 影响 datetime.now() 与文件名里的时间戳 —— 与 A 侧一致才不会让 golden 出噪声。
#SANDBOX_HOST_TZ=Asia/Shanghai

# 容器内的 uid:gid。默认 1000:1000。
# **必须与 A 上 blog 用户的 uid:gid 一致**，否则 NFS 上写不动（root_squash 会把
# root 映射成 nobody）。镜像的 Dockerfile 里已经 useradd -u 1000 -g 1000，
# docker run 这里再钉一次是纵深防御。
#SANDBOX_UID_GID=1000:1000

# ── 审计日志 ──────────────────────────────────────────────────────────────────

# JSONL 审计日志路径。默认 /var/log/sandbox-executor/exec.jsonl
# **键存在但值为空 = 显式关闭审计**（不是"用默认路径"）。
# 记录：ts / event / request_id / workspace(只有目录名) / script_bytes /
#       script_sha256_16 / timeout / exit_code / oom_killed / timed_out /
#       cancelled / stdout_lines / dropped_lines / duration_ms / docker_error
# **从不记录脚本正文** —— 用户代码可能含隐私数据，B 的日志不该变成第二份副本。
# 拒绝执行的请求也会留痕（event:"refused", reason:"mount_not_ready"），
# 排查"为什么全都不执行"时这是唯一的线索。
# 写日志失败不会影响执行：置 broken 标记 + 往 stderr 报一次，之后短路。
#SANDBOX_LOG_FILE=/var/log/sandbox-executor/exec.jsonl

# ── 监听 ──────────────────────────────────────────────────────────────────────

# 默认 0.0.0.0 —— 靠 B 的防火墙 rich rule 只放行 A 的内网 IP，别改成靠 bind 地址
# 做访问控制（内网 IP 会变，防火墙规则改了立刻生效且可审计）：
#   firewall-cmd --permanent --add-rich-rule='rule family=ipv4 source \
#     address=<A内网IP>/32 port port=8787 protocol=tcp accept'
#SANDBOX_LISTEN_HOST=0.0.0.0
#SANDBOX_LISTEN_PORT=8787
