[Unit]
Description=黑盒探测 B 的沙箱 healthz（装在服务器 A 上，每分钟）
Documentation=file:/opt/blog/docs/deployment-sandbox.md

# 独立用户而不是复用 blog：探测只需要"出网 + 一个状态目录"，让观测组件持有
# 应用用户的任何权限都没有道理。sandboxprobe 无 shell、无 home 内容。
# 建用户：useradd -r -M -s /usr/sbin/nologin sandboxprobe

[Service]
Type=oneshot
User=sandboxprobe
Group=sandboxprobe

# 必填（无 - 前缀）：URL 必须显式指向 B 的内网 IP。忘了配就 fail loud，
# 而不是拿着默认 127.0.0.1 去"探测 A 自己"然后永远返回 OK —— 那是比不探测
# 更坏的状态：绿灯是假的。
EnvironmentFile=/etc/sandbox-healthz-probe/probe.env

ExecStart=/opt/sandbox-healthz-probe/healthz-probe.sh

# 退出码 1（有 ALERT）时本单元标成 failed；OK 行进 stdout → journal。
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sandbox-healthz-probe

NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes

# 冷却戳目录。ProtectSystem=full 不影响 /var/lib 可写，但 ReadWritePaths 的
# bind mount 要求目录先存在（同 executor 的日志目录），安装手册里有 install -d。
ReadWritePaths=/var/lib/sandbox-healthz-probe

# 刻意没有 [Install] 段：本单元由 sandbox-healthz-probe.timer 触发。
