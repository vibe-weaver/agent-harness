# ══════════════════════════════════════════════════════════
#  Agent Harness 环境配置
#  用法：复制成 .env 后按需修改
#     cp backend/.env.example backend/.env
#
#  ⚠️ .env 已被 .gitignore 排除，**绝不要提交到仓库**
#     （里面会有数据库密码、JWT 密钥、邮箱授权码）
# ══════════════════════════════════════════════════════════

# ── 应用 ──
APP_NAME=Agent Harness
DEBUG=false

# ── 数据库（MySQL 8）──
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=agent_harness

# ── 认证 ──
# ⚠️ 生产环境必须修改。留默认值 = 任何人都能伪造登录令牌。
# 生成一个强密钥：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
# 登录有效期（分钟），默认 7 天
JWT_EXPIRE_MINUTES=10080

# ── CORS ──
# 前台是独立的 SPA，与后端**不同源**时需要在这里放行（逗号分隔）。
# 开发时前端跑在 Vite 默认端口；生产若用 Nginx 同域反代，可留空。
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── 邮箱注册（可选）──
# 留空 = **关闭邮箱注册**（注册接口会明确提示"邮箱服务未配置"），
# 此时用下面的初始管理员账号登录即可，不影响其他功能。
#
# 想开放邮箱注册再填这两项。QQ 邮箱需要在网页版「设置 → 账户」里
# 开启 SMTP 服务并生成**授权码**（注意不是登录密码）。
QQ_EMAIL=
QQ_EMAIL_AUTH_CODE=

# ── 首次启动自动创建的管理员（可选）──
# 仅在 users 表为空时生效（即全新数据库的第一次启动）。
# 密码留空 → 随机生成一个并打印到启动日志（只打印一次）。
# 这样即使不配 SMTP，装完也能立刻登录进去。
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_EMAIL=

# ── 沙箱执行后端 ──
# local  = 在后端本机以子进程执行用户代码（默认，单机即可跑通）
# docker = 交给 sandbox-executor 在一次性容器里执行（部署见 sandbox-executor/DEPLOY.md，单机可用）
#
# ⚠️ docker 后端不可达时**不会回落 local**（fail closed）——
#    回落等于在故障时把隔离静默撤掉，宁可这一轮工具调用明确失败。
SANDBOX_BACKEND=local
SANDBOX_EXECUTOR_URL=
SANDBOX_EXECUTOR_TOKEN=
# 灰度名单（逗号分隔的 user_id）。留空 = 全量走 docker（语义与直觉相反）
SANDBOX_DOCKER_ALLOWLIST=
# 0 = 按 CPU 核数自适应；docker 后端下应 ≤ 执行机的 SANDBOX_MAX_CONCURRENT
SANDBOX_MAX_CONCURRENT=0
# 仅用于文案（工具描述、OOM 提示），真实限制由容器的 --memory 决定
SANDBOX_DOCKER_MEMORY_MB=384
